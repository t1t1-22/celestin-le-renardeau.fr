# À COPIER UNIQUEMENT SUR LE SERVEUR dans .env (ne pas ajouter à Git).
# Utiliser 2 secrets différents de 32 caractères aléatoires minimum, sans espace.
CELESTIN_DB_PASSWORD=REMPLACER_PAR_SECRET_SQL_LONG_UNIQUE
CELESTIN_DB_ROOT_PASSWORD=REMPLACER_PAR_AUTRE_SECRET_ROOT_SQL_LONG_UNIQUE
# L'identifiant et le mot de passe du compte administrateur WordPress
# se créent ensuite via https://celestin-le-renardeau.fr/wp-admin/install.php
